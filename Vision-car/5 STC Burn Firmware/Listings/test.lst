  79          void I2C_Isr() interrupt 24
  80          {
  81   1          _push_(P_SW2);
  82   1          P_SW2 |= 0x80;
  83   1      
  84   1          if (I2CSLST & 0x40)
  85   1          {
  86   2              //setMotorSpeed(1,1);
  87   2              I2CSLST &= ~0x40;                    //处理START事件
  88   2          }
  89   1          else if (I2CSLST & 0x20)
  90   1          {
  91   2              I2CSLST &= ~0x20;                       //处理RECV事件
  92   2              if (isda)
  93   2              {
  94   3                  isda = 0;                           //处理RECV事件（RECV DEVICE ADDR）
  95   3              }
  96   2              else if (isma)
  97   2              {
  98   3                  isma = 0;                           //处理RECV事件（RECV MEMORY ADDR）
  99   3                  addr = I2CRXD;
 100   3                  I2CTXD = buffer[addr];
 101   3              }
 102   2              else
 103   2              {
 104   3                  buffer[addr++] = I2CRXD;            //处理RECV事件（RECV DATA）
 105   3                if(addr==3) addr = 0;
 106   3              }
 107   2          }
 108   1          else if (I2CSLST & 0x10)
 109   1          {
 110   2              I2CSLST &= ~0x10;                       //处理SEND事件
 111   2              if (I2CSLST & 0x02)
 112   2              {
 113   3                  I2CTXD = 0xff;                      //接收到NAK则停止读取数据
 114   3              }
 115   2              else
 116   2              {
C51 COMPILER V9.54   TEST                                                                  10/31/2024 17:05:25 PAGE 3   

 117   3                  I2CTXD = buffer[++addr];            //接收到ACK则继续读取数据
 118   3              }
 119   2          }
 120   1          else if (I2CSLST & 0x08)
 121   1          {
 122   2              I2CSLST &= ~0x08;                       //处理STOP事件
 123   2              isda = 1;
 124   2              isma = 1;
 125   2          }
 126   1      
 127   1          _pop_(P_SW2);
 128   1      }
